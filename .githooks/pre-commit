#!/bin/bash
# Refuses a commit whose staged Swift files are not formatted or do not lint, and says how to
# fix them. It only checks; nothing is rewritten behind your back. Activate once per clone:
#
#   git config core.hooksPath .githooks
set -euo pipefail

# Not scripts/: the formatter folds the comment lines after a shebang into it.
files=()
while IFS= read -r file; do
    files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.swift' ':!scripts/')
[[ ${#files[@]} -gt 0 ]] || exit 0

# `xcode-select` may point at the Command Line Tools, whose swift has no format subcommand.
if [[ -z "${DEVELOPER_DIR:-}" ]] && ! swift format --version >/dev/null 2>&1; then
    XCODE_APP="$(printf '%s\n' /Applications/Xcode*.app | sort -V | tail -1)"
    [[ -d "$XCODE_APP" ]] && export DEVELOPER_DIR="$XCODE_APP/Contents/Developer"
fi

status=0
if ! swift format lint --strict "${files[@]}"; then
    echo >&2
    echo "Unformatted. Run: swift format format --in-place ${files[*]}" >&2
    status=1
fi

swiftlint=$(command -v swiftlint || true)
if [[ -z $swiftlint ]]; then
    bundle=BuildTools/.build/artifacts/swiftlintplugins/SwiftLintBinary/SwiftLintBinary.artifactbundle/macos/swiftlint
    [[ -x $bundle ]] && swiftlint=$bundle
fi
if [[ -n $swiftlint ]]; then
    "$swiftlint" lint --strict --quiet "${files[@]}" || status=1
else
    echo "swiftlint not found; CI will run it." >&2
fi

exit $status
