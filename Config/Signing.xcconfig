// Code-signing settings that are specific to whoever builds the app.
//
// Do not edit this file with your own values: it is committed. Put them in
// Config/Signing.local.xcconfig instead (git-ignored, included below):
//
//     DEVELOPMENT_TEAM = ABCDE12345   // Xcode > Settings > Accounts
//
// APP_BUNDLE_ID is this fork's own identifier: `com.dicekeys` belongs to DiceKeys, LLC,
// and identifiers are globally unique, so no other team can sign or upload with it.
// Override it here too if you build this under a different account.

DEVELOPMENT_TEAM =
APP_BUNDLE_ID = com.cafedomingo.dicekeys
APP_ENTITLEMENTS = DiceKeys.entitlements

#include? "Signing.local.xcconfig"
