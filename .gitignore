.DS_Store
xcuserdata/
DerivedData/
build/
.build/
.claude/worktrees/

# Generated by XcodeGen (`xcodegen generate`); never commit it.
*.xcodeproj/

# Per-developer signing: team id and anything else specific to whoever builds.
# See Config/Signing.xcconfig for what belongs here.
Config/*.local.xcconfig

# App Store Connect API keys, certificates and profiles. Never commit these.
*.p8
*.p12
*.mobileprovision
*.cer

# App Store Connect API key settings for scripts/testflight.sh (see .env.example).
.env
